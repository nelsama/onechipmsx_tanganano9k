// One Chip MSX on the Tang Nano 9K (GW1NR-LV9QN88PC6/I5) - pins
// See docs/fase2-hallazgos.md for the sources of this pinout.
// The embedded PSRAM (O_psram_* / IO_psram_*) needs no entries here.

// --- 27 MHz clock ----------------------------------------------------------
IO_LOC "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Buttons and LEDs (1.8 V bank, active low) -----------------------------
IO_LOC "btn_s1_n" 4;
IO_PORT "btn_s1_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "btn_s2_n" 3;
IO_PORT "btn_s2_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "led_n[0]" 10;
IO_LOC "led_n[1]" 11;
IO_LOC "led_n[2]" 13;
IO_LOC "led_n[3]" 14;
IO_LOC "led_n[4]" 15;
IO_LOC "led_n[5]" 16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS18 DRIVE=8;

// --- HDMI (ELVDS_OBUF pairs) -----------------------------------------------
IO_LOC "tmds_ck_p" 69,68;
IO_PORT "tmds_ck_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 71,70;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 73,72;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 75,74;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

// --- microSD (SPI mode) ----------------------------------------------------
IO_LOC "sd_sck" 36;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sd_cmd" 37;
IO_PORT "sd_cmd" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sd_cs" 38;
IO_PORT "sd_cs" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sd_dat0" 39;
IO_PORT "sd_dat0" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- SPI flash P25Q32 (BIOS); MSPI pins: needs use_mspi_as_gpio ------------
IO_LOC "flash_cs_n" 60;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "flash_clk" 59;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- PS/2 keyboard (open drain, pull-ups) ----------------------------------
IO_LOC "ps2_clk" 25;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "ps2_dat" 26;
IO_PORT "ps2_dat" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Audio (PWM) -----------------------------------------------------------
IO_LOC "audio" 30;
IO_PORT "audio" IO_TYPE=LVCMOS33 DRIVE=8;
